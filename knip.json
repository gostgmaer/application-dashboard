{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/app/**/page.tsx",
    "src/app/**/layout.tsx",
    "src/app/**/loading.tsx",
    "src/app/**/error.tsx",
    "src/app/**/not-found.tsx",
    "src/app/api/**/*.ts"
  ],
  "project": ["src/**/*.{ts,tsx,js,jsx}"],
  "ignore": [
    "src/components/ui/**",
    "src/types/**"
  ],
  "ignoreDependencies": [
    "eslint",
    "eslint-config-next"
  ],
  "ignoreExportsUsedInFile": true
}
